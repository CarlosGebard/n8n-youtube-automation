# Create .env from this file before starting the stack.
# Replace both secret values with long, unique random strings.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-to-a-long-unique-password
N8N_ENCRYPTION_KEY=change-me-to-a-32-plus-character-random-key

# Local-only instance settings
N8N_LOCAL_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=America/Santiago

# API key for read-only workflow and execution status checks.
# Create it in n8n's Settings > n8n API. Do not commit the real value.
N8N_API_KEY=

# Personal access token for Codex to access n8n's instance-level MCP server.
# Copy it from n8n Settings > Instance-level MCP; never commit this value.
N8N_MCP_TOKEN=
