# Mount these paths privately in Vast; do not build them into the image.
FISH_CHECKPOINTS_DIR=/app/checkpoints/s2-pro
FISH_REFERENCE_ID=vtuber
FISH_REFERENCE_AUDIO=/app/references/vtuber.wav
FISH_REFERENCE_TRANSCRIPT=/app/references/transcript.txt

# Set to 1 only after the private reference volume is mounted.
REQUIRE_REFERENCE=1
FISH_MAX_TEXT_LENGTH=5000
