        "jsCode": "const now = new Date();\nconst cutoff = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() - 3));\n\nreturn items.filter(({ json }) => {\n  const match = String(json.name ?? '').match(/^(\\d{4}-\\d{2}-\\d{2})-/);\n  if (!match) return false;\n\n  const publishedDate = new Date(`${match[1]}T00:00:00.000Z`);\n  return !Number.isNaN(publishedDate.getTime()) && publishedDate < cutoff;\n});"
