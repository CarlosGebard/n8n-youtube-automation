{
  "name": "04 — Google Drive → Vast Fish TTS",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Probar un lote manualmente",
      "type": "n8n-nodes-base.manualTrigger",
